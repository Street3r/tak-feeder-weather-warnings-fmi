# ---------------------------------------------------------------- TAK server
# CoT stream for the FMI contact (keep-alive)
COT_URL=ssl://takserver:8089
# Old names CLIENT_CERT / CLIENT_KEY still work. The same certificate is used
# for the Mission API on API_HOST:8443.
PYTAK_TLS_CLIENT_CERT=/data/cert.pem
PYTAK_TLS_CLIENT_KEY=/data/key.pem
PYTAK_TLS_DONT_VERIFY=1
API_HOST=takserver

# ---------------------------------------------------------------- Mission
#MISSION_NAME=Weatherwarnings
# Group(s) of a new mission, comma-separated, e.g. WEATHER
#MISSION_GROUP=
#MISSION_TOKEN=
#MY_UID=fmi.0001

# ---------------------------------------------------------------- FMI
#FMI_LANG=en-GB
#FILTER_URGENCY=Expected,Immediate
# Default: all FMI warning types except UV advisories (uvNote)
#FILTER_EVENTCODE=coldWeather,forestFireWeather,grassFireWeather,hotWeather,pedestrianSafety,rain,seaIcing,seaThunderstorm,seaWaterHeight,seaWaveHeight,seaWind,thunderstorm,trafficWeather,wind
#TIMEZONE=Europe/Helsinki

# ---------------------------------------------------------------- Timing
#UPDATE_INTERVAL=3600
# Wait after a failed round (s)
#RETRY_INTERVAL=300
#DEBUG=0
